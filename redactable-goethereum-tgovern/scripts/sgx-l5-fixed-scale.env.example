# Copy this file to a private *.env file and set the scale once for an experiment.
# The repeated benchmark runner records these values and only overrides rotation
# and edit counts.  Do not put TEE_ROTATIONS, TEE_EDITS_PER_EPOCH, or
# TEE_BASELINE_EDITS in this file.

# Example fixed scale; replace these only before starting a new experiment.
TEE_CANDIDATE_COUNT=6
TEE_ACTIVE_LIMIT=4
TEE_ACTIVE_THRESHOLD=3
TEE_COMMITTEE_COUNT=4
TEE_COMMITTEE_THRESHOLD=3
LIGHT_NODE_COUNT=0
ON_ACCOUNT_COUNT=8
ON_TX_PERS=20

# --- TEE P2P topology (how densely TEE hosts interconnect) ---
# DKRS/DistKG deliver shares directly between TEE hosts; a sparse overlay forces
# broadcast fallback that does not converge under NETEM_DELAY_MS. Tune here.
# Full mesh: every TEE host peers every other (kills "recipient not connected").
# Only scales while (TEE_CANDIDATE_COUNT-1) fits within geth maxpeers (auto-raised).
# TEE_P2P_FULL_MESH=1
# Ring neighbours per direction (default min(8, TEE_COUNT//4); capped at TEE_COUNT//2).
# TEE_P2P_NEIGHBOR_RADIUS=8
# Power-of-two shortcut levels (default ceil(log2(TEE_COUNT))).
# TEE_P2P_SHORTCUT_LEVELS=6
# Miner<->TEE bridge degree (default min(8, TEE_COUNT)).
# TEE_GATEWAY_PEERS=8
# Hard cap on geth peers per node (auto-raised to fit the topology above).
# GETH_MAX_PEERS=50

# Keep the execution environment explicit and reproducible.
TEE_QUOTE_MODE=mock
SGX_MODE=SIM
